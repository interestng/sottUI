-- px width of text at a size; bytes outside printable ascii count as the face's average. markup is not stripped
function metrics.width(face: string, text: string, size: number): number
	local table_ = FACES[face]
	local total = 0
	for i = 1, #text do
		local byte = string.byte(text, i) :: number
		total += table_[byte - 31] or 0.5
	end
	return total * size
end

return metrics
